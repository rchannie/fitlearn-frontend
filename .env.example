# ============================================================
# FitLearn Frontend - Environment Template
# Salin file ini menjadi .env dan isi sesuai environment Anda
# cp .env.example .env
# ============================================================

# ── App ──────────────────────────────────────────────────────
VITE_APP_NAME=FitLearn
VITE_APP_ENV=development
VITE_APP_DEBUG=true
VITE_APP_VERSION=1.0.0

# ── Backend API (FastAPI) ─────────────────────────────────────
# Alamat dasarnya (tanpa /healthscore) juga dipakai untuk data gelang IoT:
# GET /iot/vitals/{user_id}/terbaru. Produksi: https://<domain-railway>/healthscore
VITE_API_URL=http://localhost:8000/healthscore
VITE_API_TIMEOUT=30000

# Real-time via WebSocket FastAPI. Isi URL ws untuk mengaktifkan push; bila
# kosong / koneksi gagal, app otomatis fallback ke polling HTTP.
# Saat login, app menambahkan ?user_id=<id akun> agar ikut menerima data gelang.
# Produksi: wss://<domain-railway>/ws/vitals
VITE_WS_URL=ws://localhost:8000/ws/vitals

# ── Auth (Supabase) ───────────────────────────────────────────
# Supabase Dashboard → Project Settings → API → URL & anon public key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
VITE_JWT_EXPIRE=86400

# ── Pusher / Real-time ────────────────────────────────────────
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=ap1
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=443
VITE_PUSHER_SCHEME=https

# ── Midtrans (Payment Gateway) ────────────────────────────────
VITE_MIDTRANS_CLIENT_KEY=
VITE_MIDTRANS_IS_PRODUCTION=false
VITE_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js

# ── AI / Health Monitoring ────────────────────────────────────
VITE_SENSOR_UPDATE_INTERVAL=1000
VITE_BREAK_DURATION=300
VITE_PERCLOS_THRESHOLD=0.40

# ── Map / Location ────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=

# ── Feature Flags ─────────────────────────────────────────────
VITE_ENABLE_EYE_TRACKING=true
VITE_ENABLE_GESTURE=true
VITE_ENABLE_AI_INSIGHTS=true
